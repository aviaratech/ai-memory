{{- /* Fixed Go-quoted TEXT records, not JSON. Never print matching content or arbitrary attributes. */ -}}
{{- range . -}}
{{- $rule := "UNKNOWN" -}}
{{- if regexMatch `^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$` .RuleID -}}{{- $rule = .RuleID -}}{{- end -}}
{{- $path := "UNKNOWN" -}}
{{- if and (le (len .File) 1024) (regexMatch `^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$` .File) (not (regexMatch `(^|/)\.{1,2}(/|$)` .File)) -}}{{- $path = .File -}}{{- end -}}
{{- $start := "UNKNOWN" -}}{{- $end := "UNKNOWN" -}}
{{- if and (gt .StartLine 0) (ge .EndLine .StartLine) -}}{{- $start = printf "%d" .StartLine -}}{{- $end = printf "%d" .EndLine -}}{{- end -}}
{{- $commit := "UNKNOWN" -}}
{{- if regexMatch `^([a-f0-9]{40}|[a-f0-9]{64})$` .Commit -}}{{- $commit = .Commit -}}{{- end -}}
{{- printf "finding rule=%q path=%q start=%s end=%s commit=%q\n" $rule $path $start $end $commit -}}
{{- end -}}
