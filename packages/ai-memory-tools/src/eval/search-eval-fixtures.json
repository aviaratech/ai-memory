{
  "memories": [
    {
      "category": "convention",
      "content": "Catalog convention: imported titles use sentence case while preserving proper names.",
      "id": "conv-catalog-titles",
      "tags": ["catalog", "titles", "import"]
    },
    {
      "category": "convention",
      "content": "Citation convention: list author, year, and title in that order, followed by a source URL when available.",
      "id": "conv-citation-format",
      "tags": ["citations", "format", "source"]
    },
    {
      "category": "convention",
      "content": "Catalog convention: normalize Unicode before sorting titles, while keeping original spelling for display.",
      "id": "conv-unicode-sort",
      "tags": ["catalog", "unicode", "sorting"]
    },
    {
      "category": "convention",
      "content": "Map export convention: declare coordinate units and projection in metadata; reject an export with missing units.",
      "id": "conv-map-units",
      "tags": ["maps", "units", "projection"]
    },
    {
      "category": "convention",
      "content": "CSV export convention: declare column order in the schema instead of inferring it from the first data row.",
      "id": "conv-csv-columns",
      "tags": ["csv", "schema", "columns"]
    },
    {
      "category": "convention",
      "content": "Markdown convention: heading extraction ignores fenced code blocks and retains nested heading depth.",
      "id": "conv-markdown-fences",
      "tags": ["markdown", "headings", "fences"]
    },
    {
      "category": "architecture",
      "content": "Catalog architecture: the search index owns text queries while the asset store owns uploaded binaries. Records link by document ID.",
      "id": "arch-catalog-index-assets",
      "tags": ["catalog", "search-index", "asset-store"]
    },
    {
      "category": "architecture",
      "content": "Catalog architecture: an input adapter normalizes author names before validation; canonical values persist in catalog records.",
      "id": "arch-input-normalization",
      "tags": ["catalog", "input-adapter", "normalization"]
    },
    {
      "category": "architecture",
      "content": "Catalog architecture: publishing flows through ingest, normalize, index, and publish stages. Each stage emits a typed record.",
      "id": "arch-catalog-pipeline",
      "tags": ["catalog", "pipeline", "publishing"]
    },
    {
      "category": "architecture",
      "content": "Citation architecture: when an external source is unavailable, display a cached reference with a visible stale marker.",
      "id": "arch-cached-citations",
      "tags": ["citations", "cache", "fallback"]
    },
    {
      "category": "architecture",
      "content": "Architecture decision: a memory service uses PostgreSQL full-text search for retrieval. Its indexed document combines content, project, and category fields.",
      "id": "arch-memory-search",
      "tags": ["ai-memory", "full-text-search", "mcp", "postgres"]
    },
    {
      "category": "preference",
      "content": "Editorial preference: preview page layout before publishing a catalog update.",
      "id": "pref-preview-layout",
      "tags": ["preview", "layout", "publishing"]
    },
    {
      "category": "preference",
      "content": "Editorial preference: use a publication tool that records release notes and version numbers.",
      "id": "pref-publish-tool",
      "tags": ["publication", "release-notes", "version"]
    },
    {
      "category": "preference",
      "content": "Editorial preference: reviewers check citation links before approving catalog entries.",
      "id": "pref-citation-review",
      "tags": ["review", "citations", "approval"]
    },
    {
      "category": "preference",
      "content": "Editorial preference: ask an independent curator to verify complex catalog metadata.",
      "id": "pref-independent-curator",
      "tags": ["curator", "metadata", "review"]
    },
    {
      "category": "preference",
      "content": "Editorial preference: record durable catalog decisions and evidence references for future editors.",
      "id": "pref-record-decisions",
      "tags": ["catalog", "decisions", "evidence"]
    },
    {
      "category": "bugfix",
      "content": "Root cause: a multi-word search returned no results because an AND query required all terms in one memory. A literal phrase fallback also missed paraphrases.",
      "id": "root-search-zero-results",
      "tags": ["ai-memory", "postgres", "search", "tsquery", "zero-results"]
    },
    {
      "category": "bugfix",
      "content": "Root cause: a page cursor was encoded before stable title sorting, so entries repeated across catalog pages. Encode the cursor after sorting.",
      "id": "root-pagination-cursor",
      "tags": ["catalog", "pagination", "cursor"]
    },
    {
      "category": "bugfix",
      "content": "Root cause: a missing locale selected the wrong date format on exhibit cards. Require an explicit locale before rendering dates.",
      "id": "root-locale-date",
      "tags": ["exhibits", "locale", "dates"]
    },
