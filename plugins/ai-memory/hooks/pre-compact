#!/usr/bin/env bash
# Automatic checkpoint failure never blocks compaction or forwards partial output.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
if [ -f "${PLUGIN_ROOT}/dist/mcp-launcher.js" ]; then
  if output=$(node "${PLUGIN_ROOT}/dist/mcp-launcher.js" hook:pre-compact 2>/dev/null); then
    printf '%s\n' "$output"
    exit 0
  fi
fi
printf '{"continue":true,"systemMessage":"ai-memory: session checkpoint unavailable."}\n'
exit 0
