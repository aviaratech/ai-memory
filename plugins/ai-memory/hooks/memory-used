#!/usr/bin/env bash
# Narrow memory_get observation is advisory and emits no model context.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
if [ -f "${PLUGIN_ROOT}/dist/mcp-launcher.js" ]; then
  if output=$(node "${PLUGIN_ROOT}/dist/mcp-launcher.js" hook:memory-used 2>/dev/null); then
    printf '%s\n' "$output"
    exit 0
  fi
fi
printf '{"continue":true}\n'
exit 0
